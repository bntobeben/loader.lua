-- Tabel Penyimpanan Titik
local SavedPoints = {}

-- Fungsi untuk memperbarui tampilan daftar titik
local function updatePointList()
    -- Hapus elemen lama di UI
    for _, child in ipairs(ScrollingFrame:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end
    
    -- Buat ulang baris berdasarkan data SavedPoints
    for index, data in ipairs(SavedPoints) do
        local ItemRow = Instance.new("Frame")
        ItemRow.Size = UDim2.new(1, -5, 0, 35)
        ItemRow.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
        ItemRow.Parent = ScrollingFrame
        
        local RowCorner = Instance.new("UICorner")
        RowCorner.CornerRadius = UDim.new(0, 4)
        RowCorner.Parent = ItemRow
        
        -- Label Nama & Koordinat
        local LabelInfo = Instance.new("TextLabel")
        LabelInfo.Size = UDim2.new(1, -160, 1, 0)
        LabelInfo.Position = UDim2.new(0, 10, 0, 0)
        LabelInfo.BackgroundTransparency = 1
        LabelInfo.Text = string.format("%d   |   CP%d   |   Vector3.new(%.2f, %.2f, %.2f)", index-1, index, data.X, data.Y, data.Z)
        LabelInfo.TextColor3 = Color3.fromRGB(220, 220, 220)
        LabelInfo.Font = Enum.Font.SourceSans
        LabelInfo.TextSize = 11
        LabelInfo.TextXAlignment = Enum.TextXAlignment.Left
        LabelInfo.Parent = ItemRow
        
        -- Tombol TP Cepat per Baris
        local tpBtn = Instance.new("TextButton")
        tpBtn.Size = UDim2.new(0, 35, 0, 25)
        tpBtn.Position = UDim2.new(1, -75, 0, 5)
        tpBtn.BackgroundColor3 = Color3.fromRGB(40, 100, 160)
        tpBtn.Text = "TP"
        tpBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        tpBtn.Font = Enum.Font.SourceSansBold
        tpBtn.TextSize = 11
        tpBtn.Parent = ItemRow
        
        local tpCorner = Instance.new("UICorner")
        tpCorner.CornerRadius = UDim.new(0, 3)
        tpCorner.Parent = tpBtn
        
        tpBtn.MouseButton1Click:Connect(function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                char.HumanoidRootPart.CFrame = CFrame.new(data)
            end
        end)
        
        -- Tombol Hapus per Baris (X)
        local delBtn = Instance.new("TextButton")
        delBtn.Size = UDim2.new(0, 25, 0, 25)
        delBtn.Position = UDim2.new(1, -35, 0, 5)
        delBtn.BackgroundColor3 = Color3.fromRGB(160, 40, 40)
        delBtn.Text = "X"
        delBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        delBtn.Font = Enum.Font.SourceSansBold
        delBtn.TextSize = 11
        delBtn.Parent = ItemRow
        
        local delCorner = Instance.new("UICorner")
        delCorner.CornerRadius = UDim.new(0, 3)
        delCorner.Parent = delBtn
        
        delBtn.MouseButton1Click:Connect(function()
            table.remove(SavedPoints, index)
            updatePointList()
        end)
    end
    
    ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, #SavedPoints * 40)
end

-- Fungsi Tombol "+ Posisi Saya"
btnPosSaya.MouseButton1Click:Connect(function()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        table.insert(SavedPoints, char.HumanoidRootPart.Position)
        updatePointList()
    end
end)

-- Tombol Hapus Semua Tab
btnHapusTab.MouseButton1Click:Connect(function()
    SavedPoints = {}
    updatePointList()
end)
